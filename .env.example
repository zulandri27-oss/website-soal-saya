# GEMINI_API_KEY: Required for Gemini AI API calls (/api/stimulus/generate, /api/questions/generate, /api/questions/refine).
# On Vercel: add this under Project Settings > Environment Variables.
# In AI Studio: configure via Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional deployment URL for self-referential links.
APP_URL="MY_APP_URL"
